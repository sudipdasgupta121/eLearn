# Postgres connection string (Neon / Render / local). Never commit the real one.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/upskill
# Required in production: random string, >= 32 chars (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=change-me-in-production-use-a-long-random-string
PORT=4000
# NODE_ENV=production
# Expose the "fast-forward billing period" demo endpoint (keep OFF in real production)
# ENABLE_DEMO_TOOLS=true
# Number of reverse proxies in front of the app (Render = 1, default in production)
# TRUST_PROXY=1
# Only if the frontend is served from a different origin (comma separated)
# CORS_ORIGINS=https://example.com
# TLS to the DB is verified by default for remote hosts. Escape hatches: PG_SSL=no-verify | disable
