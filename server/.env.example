# Postgres connection string (Neon / Render / local). Never commit the real one.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/upskill
# Required in production: random string, >= 32 chars (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=change-me-in-production-use-a-long-random-string
PORT=4000
# NODE_ENV=production
# Expose the "fast-forward billing period" demo endpoint (keep OFF in real production)
# ENABLE_DEMO_TOOLS=true
# Number of reverse proxies in front of the app (Render = 1, default in production)
# TRUST_PROXY=1
# Only if the frontend is served from a different origin (comma separated)
# CORS_ORIGINS=https://example.com
# TLS to the DB is verified by default for remote hosts. Escape hatches: PG_SSL=no-verify | disable

# --- Observability: Grafana Cloud via OpenTelemetry (OTLP). Leave the endpoint UNSET to disable. ---
# Grafana Cloud portal -> your stack -> OpenTelemetry -> Configure. HEADERS = Authorization=Basic <base64(instanceId:token)>
# OTEL_SERVICE_NAME=upskill
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>
# OTEL_SDK_DISABLED=true     # force-disable (test runners already do this)
# LOG_LEVEL=info

# --- Slack notifications (Incoming Webhook). Leave unset to disable. ---
# Slack: api.slack.com/apps -> Create app -> Incoming Webhooks -> Add New Webhook to Workspace
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxx
# SLACK_ENV_LABEL=production     # label shown in the message footer (default: NODE_ENV)
# SLACK_DISABLED=true            # force-disable (test runners already do this)
