{
  "name": "upskill",
  "version": "1.0.0",
  "private": true,
  "description": "upSkill - eLearning platform MVP (React + Node/Express + PostgreSQL)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "node --import ./server/telemetry.js server/index.js",
    "dev:db": "npm run db:local --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "test": "npm test --prefix server",
    "test:unit": "npm run test:unit --prefix server",
    "test:integration": "npm run test:integration --prefix server",
    "test:e2e": "node tests/e2e/run.js",
    "test:e2e:debug": "playwright test --config=tests/e2e/playwright.config.js --debug",
    "test:e2e:report": "playwright show-report tests/e2e/playwright-report",
    "test:all": "npm test && npm run test:e2e",
    "perf": "node tests/perf/run-perf.js",
    "perf:baseline": "node tests/perf/run-perf.js --update-baseline"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "dotenv": "^18.0.10"
  }
}
